---

# Generic
generic:
  role: ansible-role-haproxy
  role_short: haproxy
  role_description: |
    Manage HAProxy

# Supported platforms
platforms:
  ubuntu2004:
    supported: true
    ci: true
  fedora43:
    supported: false
    ci: false
  fedora44:
    supported: false
    ci: false

# Dependencies
dependencies:
  roles:
    - deitkrachten.docker_compose
    - deitkrachten.firewall
    - deitkrachten.sysctl

# Molecule
molecule:
  nodes:
    - name: nginx1
      groups:
        - nginx
    - name: nginx2
      groups:
        - nginx
    - name: master
      groups:
        - haproxy
        - keepalived_master
    - name: backup
      groups:
        - haproxy
        - keepalived_backup
  prepare:
    vars:
      prepare_firewall: true
      activate_epel: true
      install_python: true
  requirements:
    roles_extra:
      - deitkrachten.keepalived
      - deitkrachten.nginx
      - deitkrachten.rsyslog
      - deitkrachten.sysctl

# CI templates
ci_templates:
  # molecule.yml.j2:
  #   force: false
  converge.yml:
    force: false
